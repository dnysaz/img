---
const waLink = 'https://wa.me/6281339299209?text=Hello%20IMG%2C%20I%20need%20information%20about%20cruise%20line%20career%20opportunities';
---

<section class="bg-navy text-white relative overflow-hidden min-h-[90vh] flex items-center">
  <div class="absolute inset-0 opacity-[0.04]" style="background-image:repeating-linear-gradient(45deg,#fff 0px,#fff 1px,transparent 1px,transparent 24px);"></div>
  <div class="absolute -top-40 -right-40 w-96 h-96 rounded-full bg-brick/10 blur-[120px]"></div>
  <div class="absolute -bottom-40 -left-40 w-80 h-80 rounded-full bg-orange/5 blur-[100px]"></div>
  <div class="absolute top-1/2 right-1/4 w-64 h-64 border border-white/5 rounded-full"></div>
  <div class="absolute top-1/3 right-1/3 w-40 h-40 border border-white/5 rounded-full"></div>
  <div class="absolute bottom-1/4 right-[15%] text-[30vw] font-black text-white/5 leading-none select-none pointer-events-none">&#9875;</div>
  <div class="max-w-7xl mx-auto px-6 py-28 md:py-0 relative w-full">
    <div class="grid md:grid-cols-2 gap-16 items-center">
      <div class="max-w-xl">
        <div class="flex items-center gap-3 mb-8 reveal">
          <span class="h-px w-8 bg-brick"></span>
          <span class="text-xs font-bold text-brick tracking-[0.2em] uppercase">Maritime &amp; Hospitality Recruitment</span>
        </div>
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-black leading-[0.95] tracking-tight reveal" style="transition-delay:0.1s">
          Cruise Line<br />
          <span class="text-white/50">Career Solutions</span>
        </h1>
        <p class="text-white/50 text-lg md:text-xl leading-relaxed mt-8 reveal" style="transition-delay:0.2s">
          Connecting talented individuals with international opportunities in maritime and hospitality.
          Based in Bali, serving the world.
        </p>
        <div class="flex flex-wrap gap-4 mt-10 reveal" style="transition-delay:0.3s">
          <a href="#contact" class="bg-brick hover:bg-brickLight text-white font-bold px-8 py-4 text-sm transition-colors inline-flex items-center gap-2">
            <i class="ri-whatsapp-fill text-base"></i>
            Get in Touch
          </a>
          <a href="#about" class="border border-white/20 text-white/70 font-medium px-8 py-4 text-sm hover:border-white/40 hover:text-white transition-colors inline-flex items-center gap-2">
            Learn More
          </a>
        </div>
      </div>
      <div class="hidden md:flex justify-center items-center reveal" style="transition-delay:0.3s">
        <div class="relative w-80 h-80">
          <div class="absolute inset-0 border border-white/10 rounded-full animate-pulse" style="animation-duration:6s"></div>
          <div class="absolute inset-[12%] border border-white/[0.06] rounded-full"></div>
          <div class="absolute inset-[24%] bg-white/[0.03] rounded-full border border-white/[0.08] flex items-center justify-center">
            <div class="text-center">
              <i class="ri-anchor-line text-6xl text-brick/60"></i>
              <p class="text-[10px] font-bold text-white/20 tracking-[0.3em] uppercase mt-4">Maritime</p>
            </div>
          </div>
          <div class="absolute -top-4 -right-4 h-14 w-14 bg-navyLight border border-white/10 rounded-full flex items-center justify-center">
            <i class="ri-ship-2-line text-xl text-orange"></i>
          </div>
          <div class="absolute -bottom-2 -left-2 h-12 w-12 bg-navyLight border border-white/10 rounded-full flex items-center justify-center">
            <i class="ri-global-line text-lg text-brick"></i>
          </div>
          <div class="absolute top-[8%] left-[6%] h-10 w-10 bg-navyLight border border-white/10 rounded-full flex items-center justify-center">
            <i class="ri-team-line text-base text-white/40"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="grid grid-cols-3 gap-8 mt-20 pt-12 border-t border-white/10 max-w-lg reveal" style="transition-delay:0.4s">
      <div>
        <p class="text-3xl md:text-4xl font-black text-white">2022</p>
        <p class="text-xs text-white/40 mt-1 tracking-wider">Founded</p>
      </div>
      <div>
        <p class="text-3xl md:text-4xl font-black text-white">Global</p>
        <p class="text-xs text-white/40 mt-1 tracking-wider">Network</p>
      </div>
      <div>
        <p class="text-3xl md:text-4xl font-black text-white">100%</p>
        <p class="text-xs text-white/40 mt-1 tracking-wider">Dedicated</p>
      </div>
    </div>
  </div>
</section>
