---
const waNumber = '6281339299209';
const waLink = `https://wa.me/${waNumber}?text=Hello%20IMG%2C%20I%20need%20information%20about%20cruise%20line%20career%20opportunities`;
---

<nav class="bg-navy border-b-[3px] border-brick sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    <a href="#" class="flex items-center gap-3">
      <img src="https://pub-ba02358b32f843559b79dfd510299658.r2.dev/img-logo.jpg" alt="Inti Marina Global" class="h-10 w-auto" />
      <span class="text-lg font-black tracking-tight text-white">INTI MARINA</span>
      <span class="text-xs font-medium text-white/40">GLOBAL</span>
    </a>
    <div class="hidden md:flex items-center gap-8">
      <a href="#about" class="text-sm text-white/70 hover:text-white transition-colors">About</a>
      <a href="#services" class="text-sm text-white/70 hover:text-white transition-colors">Services</a>
      <a href="#process" class="text-sm text-white/70 hover:text-white transition-colors">Process</a>
      <a href="#why-us" class="text-sm text-white/70 hover:text-white transition-colors">Why Us</a>
      <a href="#contact" class="text-sm text-white/70 hover:text-white transition-colors">Contact</a>
      <a href={waLink} target="_blank" rel="noopener" class="bg-brick hover:bg-brickLight text-white text-sm font-bold px-5 py-2.5 transition-colors">Get in Touch</a>
    </div>
    <button id="menu-btn" class="md:hidden text-white h-10 w-10 border border-white/20 grid place-items-center hover:bg-white/10 transition-colors cursor-pointer" aria-label="Open menu">
      <i id="menu-icon" class="ri-menu-line text-lg"></i>
    </button>
  </div>
</nav>

<div id="mobile-menu" class="md:hidden fixed inset-0 z-50 bg-navy translate-x-full transition-transform duration-300">
  <div class="flex justify-end px-6 py-4">
    <button id="menu-close" class="text-white h-10 w-10 border border-white/20 grid place-items-center hover:bg-white/10 transition-colors cursor-pointer" aria-label="Close menu">
      <i class="ri-close-line text-lg"></i>
    </button>
  </div>
  <nav class="flex flex-col items-center justify-center h-full -mt-20 gap-10 text-center">
    <a href="#about" class="mobile-link text-2xl font-bold text-white/80 hover:text-white transition-colors">About</a>
    <a href="#services" class="mobile-link text-2xl font-bold text-white/80 hover:text-white transition-colors">Services</a>
    <a href="#process" class="mobile-link text-2xl font-bold text-white/80 hover:text-white transition-colors">Process</a>
    <a href="#why-us" class="mobile-link text-2xl font-bold text-white/80 hover:text-white transition-colors">Why Us</a>
    <a href="#contact" class="mobile-link text-2xl font-bold text-white/80 hover:text-white transition-colors">Contact</a>
    <a href={waLink} target="_blank" rel="noopener" class="mobile-link bg-brick text-white px-10 py-4 text-lg font-bold hover:bg-brickLight transition-colors">Get in Touch</a>
  </nav>
</div>
